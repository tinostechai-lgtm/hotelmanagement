{
  "name": "Servora POS",
  "short_name": "Servora",
  "description": "Restaurant & hotel POS, QR ordering and home delivery",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14123A",
  "theme_color": "#14123A",
  "icons": [
    {"src": "/static/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/static/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/static/brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
    {"src": "/static/brand/servora-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"}
  ]
}
