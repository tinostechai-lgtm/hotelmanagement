# Vercel → Project → Settings → Environment Variables
# Only these are required. Razorpay, email (SMTP), SMS/WhatsApp, Maps and the
# aggregator secret are configured in the Super admin → Platform settings page.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://user:pass@host:5432/servora?sslmode=require

# Optional
# DJANGO_DEBUG=false                       # default on Vercel
# DJANGO_ALLOWED_HOSTS=.vercel.app,yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://yourdomain.com
# SERVORA_AUTO_MIGRATE=1                   # create/update tables automatically on deploy
# UNPAID_ONLINE_ORDER_TTL_MINUTES=20
