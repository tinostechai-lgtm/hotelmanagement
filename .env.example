# Copy into Vercel → Project → Settings → Environment Variables
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.vercel.app,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://yourdomain.com
DATABASE_URL=postgres://user:pass@host:5432/servora?sslmode=require
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
AGGREGATOR_WEBHOOK_SECRET=xxxxxxxx
TIME_ZONE=Asia/Kolkata
